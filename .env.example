# Application origin and launch community.
# Google callback: ${PUBLIC_APP_URL}/api/auth/google/callback
# Apple return URL: ${PUBLIC_APP_URL}/api/auth/apple/callback
PUBLIC_APP_URL=
LAUNCH_COMMUNITY_ID=
LAUNCH_COMMUNITY_NAME=

# Generate separate random values of at least 32 bytes for each signing secret.
AUTH_SESSION_SECRET=
AUTH_TRANSACTION_SECRET=

# OAuth credentials. APPLE_PRIVATE_KEY must be a PKCS#8 .p8 value; escaped newlines are accepted.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Development only. Set both to true locally to expose the demo sign-in button.
AUTH_DEMO_MODE=
NEXT_PUBLIC_AUTH_DEMO_MODE=

# ISBN metadata providers.
NLK_API_KEY=
GOOGLE_BOOKS_API_KEY=

# US messaging providers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
EMAIL_FROM=
INTERNAL_JOB_SECRET=

# Member contact privacy. AES key is base64url-encoded 32 bytes; hash key is 32+ characters.
CONTACT_ENCRYPTION_KEY=
CONTACT_HASH_KEY=
