# Application origin and launch community.
# Kakao callback: ${PUBLIC_APP_URL}/api/auth/kakao/callback
# Google callback: ${PUBLIC_APP_URL}/api/auth/google/callback
PUBLIC_APP_URL=
LAUNCH_COMMUNITY_ID=
LAUNCH_COMMUNITY_NAME=

# Generate separate random values of at least 32 bytes for each signing secret.
AUTH_SESSION_SECRET=
AUTH_TRANSACTION_SECRET=

# Kakao Login OIDC, private My Chatroom notifications, and Korean book lookup. Enable talk_message consent.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Google Login OIDC. The authorized redirect URI must use the canonical app origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development only. Set both to true locally to expose the demo sign-in button.
AUTH_DEMO_MODE=
NEXT_PUBLIC_AUTH_DEMO_MODE=

# ISBN metadata providers.
NLK_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=

# Legacy SMS fallback provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Resend sends circulation email to Google or member-supplied addresses.
RESEND_API_KEY=
EMAIL_FROM="Hana Seed Library <notifications@library.hanaseed.org>"
INTERNAL_JOB_SECRET=

# Member contact privacy. AES key is base64url-encoded 32 bytes; hash key is 32+ characters.
CONTACT_ENCRYPTION_KEY=
CONTACT_HASH_KEY=
