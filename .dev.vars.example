# Local/production integration contract. Never commit real values.
DEPLOYMENT_REGION=us-west
PUBLIC_APP_URL=http://localhost:4173
APP_RUNTIME_MODE=development
LAUNCH_COMMUNITY_ID=
LAUNCH_COMMUNITY_NAME=
AUTH_SESSION_SECRET=
AUTH_TRANSACTION_SECRET=

# Development only. Set both to true to expose the explicit demo sign-in path.
AUTH_DEMO_MODE=
NEXT_PUBLIC_AUTH_DEMO_MODE=

# Kakao Login OIDC. Register ${PUBLIC_APP_URL}/api/auth/kakao/callback as the redirect URI.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# ISBN metadata stitching.
NLK_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
ALADIN_TTB_KEY=
GOOGLE_BOOKS_API_KEY=
# Local/test only. Production always rejects fixture fallback even if set.
ISBN_FIXTURES_ENABLED=true

# Legacy rollback-only SMS/email providers. Not required by the Kakao-only UI.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
EMAIL_FROM=

# Outbox scheduler authentication. Generate at least 32 random bytes.
INTERNAL_JOB_SECRET=

# Phone endpoints remain inactive until their ownership is verified.

# Member contact privacy. AES key is base64url-encoded 32 bytes; hash key is 32+ characters.
CONTACT_ENCRYPTION_KEY=
CONTACT_HASH_KEY=

# Standards-based Web Push (VAPID). The subject must be an https: or mailto: URI.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=http://localhost:4173
