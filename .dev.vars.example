# Local/production integration contract. Never commit real values.
DEPLOYMENT_REGION=us-west
PUBLIC_APP_URL=http://localhost:3000
LAUNCH_COMMUNITY_ID=
LAUNCH_COMMUNITY_NAME=
AUTH_SESSION_SECRET=
AUTH_TRANSACTION_SECRET=

# Development only. Set both to true to expose the explicit demo sign-in path.
AUTH_DEMO_MODE=
NEXT_PUBLIC_AUTH_DEMO_MODE=

# External OAuth. Configure callback URLs in Google Cloud and Apple Developer.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ISBN metadata stitching.
NLK_API_KEY=
GOOGLE_BOOKS_API_KEY=

# US SMS and transactional email.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
EMAIL_FROM=
